# Application Environment Variables
ENVIRONMENT=production
DEBUG=false

# Database Configuration
# Default local SQLite:
DATABASE_URL=sqlite:///data/sme_retention.db

# Docker / PostgreSQL Configuration:
# DATABASE_URL=postgresql://sme_admin:sme_secure_password@localhost:5432/sme_retention_db

# Pipeline Random Seed
RANDOM_SEED=42
NUM_SMES=6000
PREDICTION_CUTOFF=2023-09-30

# API Settings
HOST=127.0.0.1
PORT=8000
